<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Golden Olfactory Glow -->
    <path
        android:pathData="M54,54m-28,0a28,28 0 1,0 56,0a28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="28"
                android:type="radial">
                <item android:offset="0.0" android:color="#4DF5A623" />
                <item android:offset="0.7" android:color="#1AD4AF37" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Perfume Bottle Cap (Metallic Gold) -->
    <path
        android:pathData="M48,27 h12 v9 h-12 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="27"
                android:endX="60"
                android:endY="36"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE599" />
                <item android:offset="0.5" android:color="#D4AF37" />
                <item android:offset="1.0" android:color="#996515" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Collar / Atomizer Neck -->
    <path
        android:pathData="M51,36 h6 v4 h-6 z"
        android:fillColor="#FFE599" />

    <!-- Bottle Body (Faceted Crystal Flacon) -->
    <path
        android:pathData="M41,41 h26 l7,10 v27 l-4,4 h-32 l-4,-4 v-27 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="40"
                android:endX="74"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#F0D4AF37" />
                <item android:offset="0.3" android:color="#D0C59B27" />
                <item android:offset="0.7" android:color="#E0A67C1E" />
                <item android:offset="1.0" android:color="#B07B5200" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottle Inner Essence Cavity -->
    <path
        android:pathData="M43,46 h22 l4,7 v23 l-2,2 h-28 l-2,-2 v-23 z"
        android:fillColor="#40120F0D" />

    <!-- Pure Botanical Scent Core / Drop -->
    <path
        android:pathData="M54,53 C54,53 48,61 48,65 C48,68.3 50.7,71 54,71 C57.3,71 60,68.3 60,65 C60,61 54,53 54,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="53"
                android:endX="60"
                android:endY="71"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF3C4" />
                <item android:offset="1.0" android:color="#F5A623" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crystal Bevel Highlights -->
    <path
        android:pathData="M41,41 l7,10 v27"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
    <path
        android:pathData="M67,41 l-7,10 v27"
        android:strokeColor="#40000000"
        android:strokeWidth="1"
        android:fillColor="#00000000" />
</vector>

